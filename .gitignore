# Track the UI source and its small local-development tools only.
/*
!/.gitignore
!/README.md
!/index.html
!/features/
!/shared/
!/data/
!/assets/
!/scripts/
/scripts/*
!/scripts/prepare-local.cjs
!/scripts/serve.cjs

# Keep deployment, agent state and generated output outside this repository.
**/.openai/
**/.codex/
**/.claude/
**/.agents/
**/.superpowers/
**/.sites-runtime/
**/.sites-checkout/
**/AGENTS.md
**/CLAUDE.md
**/SKILL.md
**/node_modules/
**/dist/
**/*.log
**/.DS_Store
**/Thumbs.db
/assets/.*
